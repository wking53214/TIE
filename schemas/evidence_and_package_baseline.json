{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TIE_PACKAGE — Reconstructed Implementation Baseline",
  "description": "A reconstructed machine-readable contract based on the five supplied TIE forensic summaries. This is not claimed to be the exact historical schema.",
  "type": "object",
  "required": ["package_id", "source", "coverage", "evidence", "artifacts", "identity_references", "relationships", "knowledge_views", "routing_signal", "build_classification"],
  "properties": {
    "package_id": {"type": "string"},
    "source": {"$ref": "#/$defs/source"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "identity_references": {"type": "array", "items": {"$ref": "#/$defs/identity"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "reconstruction": {"anyOf": [{"$ref": "#/$defs/reconstruction"}, {"type": "null"}]},
    "validation": {"anyOf": [{"$ref": "#/$defs/validation"}, {"type": "null"}]},
    "knowledge_views": {"type": "object"},
    "typed_handoff": {"anyOf": [{"$ref": "#/$defs/handoff"}, {"type": "null"}]},
    "routing_signal": {"type": ["string", "null"]},
    "build_classification": {"type": "string"}
  },
  "$defs": {
    "source_ref": {
      "type": "object", "required": ["source_id"], "properties": {
        "source_id": {"type": "string"}, "source_location": {"type": ["string", "null"]},
        "conversation_id": {"type": ["string", "null"]}, "message_id": {"type": ["string", "null"]},
        "segment_id": {"type": ["string", "null"]}
      }, "additionalProperties": false
    },
    "provenance": {
      "type": "object", "properties": {
        "source": {"anyOf": [{"$ref": "#/$defs/source_ref"}, {"type": "null"}]},
        "origin": {"type": "string"}, "extraction_origin": {"type": ["string", "null"]},
        "transformation_origin": {"type": ["string", "null"]}, "lineage_id": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]}, "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "source": {
      "type": "object", "required": ["source_id", "content", "media_type", "title", "provenance"],
      "properties": {"source_id": {"type": "string"}, "content": {"type": "string"}, "media_type": {"type": "string"}, "title": {"type": ["string", "null"]}, "provenance": {"$ref": "#/$defs/provenance"}}
    },
    "coverage_segment": {
      "type": "object", "required": ["segment_id", "ordinal", "start_char", "end_char", "status"],
      "properties": {"segment_id": {"type": "string"}, "ordinal": {"type": "integer"}, "start_char": {"type": "integer", "minimum": 0}, "end_char": {"type": "integer", "minimum": 0}, "status": {"type": "string"}, "source_id": {"type": ["string", "null"]}, "checksum": {"type": ["string", "null"]}, "notes": {"type": "array", "items": {"type": "string"}}}
    },
    "coverage": {"type": "object", "required": ["source_id", "segments"], "properties": {"source_id": {"type": "string"}, "segments": {"type": "array", "items": {"$ref": "#/$defs/coverage_segment"}}}},
    "evidence": {
      "type": "object", "required": ["evidence_id", "statement", "epistemic_status", "source_ref", "provenance"],
      "properties": {"evidence_id": {"type": "string"}, "statement": {"type": "string"}, "epistemic_status": {"enum": ["EXPLICIT", "INFERRED", "UNKNOWN", "CONFLICTED"]}, "source_ref": {"$ref": "#/$defs/source_ref"}, "provenance": {"$ref": "#/$defs/provenance"}, "segment_id": {"type": ["string", "null"]}, "artifact_ids": {"type": "array", "items": {"type": "string"}}, "relationship_ids": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "array", "items": {"type": "string"}}}
    },
    "artifact": {"type": "object", "required": ["artifact_id", "name"], "properties": {"artifact_id": {"type": "string"}, "name": {"type": "string"}, "artifact_type": {"type": ["string", "null"]}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}}, "provenance": {"$ref": "#/$defs/provenance"}, "version": {"type": ["string", "null"]}, "supersedes": {"type": "array", "items": {"type": "string"}}, "identity_uncertain": {"type": "boolean"}, "notes": {"type": "array", "items": {"type": "string"}}}},
    "identity": {"type": "object", "required": ["reference_id", "identity_key", "source_ref"], "properties": {"reference_id": {"type": "string"}, "identity_key": {"type": "string"}, "source_ref": {"$ref": "#/$defs/source_ref"}, "confidence_note": {"type": ["string", "null"]}, "uncertain": {"type": "boolean"}}},
    "relationship": {"type": "object", "required": ["relationship_id", "subject_id", "predicate", "object_id", "epistemic_status", "provenance"], "properties": {"relationship_id": {"type": "string"}, "subject_id": {"type": "string"}, "predicate": {"type": "string"}, "object_id": {"type": "string"}, "epistemic_status": {"enum": ["EXPLICIT", "INFERRED", "UNKNOWN", "CONFLICTED"]}, "provenance": {"$ref": "#/$defs/provenance"}, "notes": {"type": "array", "items": {"type": "string"}}}},
    "reconstruction": {"type": "object", "required": ["reconstruction_id", "text", "evidence_ids", "epistemic_status", "provenance"], "properties": {"reconstruction_id": {"type": "string"}, "text": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "epistemic_status": {"enum": ["EXPLICIT", "INFERRED", "UNKNOWN", "CONFLICTED"]}, "provenance": {"$ref": "#/$defs/provenance"}, "conflict_notes": {"type": "array", "items": {"type": "string"}}}},
    "validation": {"type": "object", "required": ["valid", "checks", "errors", "warnings"], "properties": {"valid": {"type": "boolean"}, "checks": {"type": "object"}, "errors": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}}},
    "handoff": {"type": "object", "required": ["objective", "source_id", "evidence_ids", "artifact_ids", "known_uncertainty"], "properties": {"objective": {"type": "string"}, "source_id": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "artifact_ids": {"type": "array", "items": {"type": "string"}}, "known_uncertainty": {"type": "array", "items": {"type": "string"}}, "routing_signal": {"type": ["string", "null"]}, "provenance": {"$ref": "#/$defs/provenance"}}}
  }
}
